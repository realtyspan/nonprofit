datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String?  @unique // public-facing URL segment, shared across modules' public pages (rentals, calendar)
  contactEmail    String?  // used as the Reply-To on buyer-facing emails (e.g. Raffle) sent from the platform's shared sender address
  licenseId       String?
  address         String?
  county          String?  // Schedule 1 / GC-7Q header field
  municipality    String?  // Schedule 1 / GC-7Q header field
  licenseCategory String?  // Schedule 1 / GC-7Q header field (e.g. "Bell Jar")
  licenseLast5    String?  // last 5 digits of the GC license number, per the Schedule 1 header
  plan            String   @default("trial") // trial | active | canceled
  createdAt       DateTime @default(now())

  users          User[]
  deals          Deal[]
  disbursements  Disbursement[]
  reports        GC7QReport[]
  rentalSpaces           RentalSpace[]
  rentalBookings         RentalBooking[]
  rentalPayments         RentalPayment[]
  rentalLogs             RentalLog[]
  rentalBlocks           RentalBlock[]
  rentalBlockRecurrences RentalBlockRecurrence[]
  calendarEvents         CalendarEvent[]
  calendarRecurrences    CalendarRecurrence[]
  orgMemberships         OrgMembership[]
  moduleGrants           ModuleGrant[]
  tierLabel              TierLabel?
  gc7qSignerDesignations GC7QSignerDesignation[]
  raffleGames            RaffleGame[]
  raffleTickets          RaffleTicket[]
  raffleLogs             RaffleLog[]
  raffleDrawings         RaffleDrawing[]
  raffleRenewalCalls     RaffleRenewalCall[]
  raffleCheckIns         RaffleCheckIn[]
  raffleExpenses         RaffleExpense[]
  raffleSignerDesignations RaffleSignerDesignation[]
  raffleEmailSuppressions  RaffleEmailSuppression[]
  frsReportRuns            FrsReportRun[]
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  role         String   // Cashier | Chairperson | Preparer | Head
  title        String?  // e.g. "Treasurer" — used on the GC-7Q affirmation block
  phone        String?
  homeAddress  String?  // "Home Address, City and Zip Code" per the GC-7Q affirmation block
  createdAt    DateTime @default(now())

  signOffs SignOff[]
  orgMembership          OrgMembership?
  moduleGrants           ModuleGrant[]
  gc7qSignerDesignations GC7QSignerDesignation[]
  raffleSignerDesignations RaffleSignerDesignation[]
  raffleAssignments      RaffleTicket[] @relation("RaffleAssignedSeller")
  passwordResets         PasswordReset[]
  createdCalendarEvents  CalendarEvent[]

  @@index([orgId])
}

// Single-use, expiring token for the "forgot password" email-link flow. A
// lookup table rather than a JWT so a token can be invalidated the moment
// it's used (or superseded by a newer request) without needing a blocklist.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Org-wide tier: Owner (technical administrator — manages users/permissions,
// views everything, no automatic edit rights in any module) or Viewer
// (grantable to any number of people — read-only everywhere, e.g. a lodge's
// actual titled officer who wants visibility without doing data entry).
// Mutually exclusive and at most one per user, enforced via @@unique(userId)
// rather than left to application logic, since the zero-Owner guardrail
// depends on being able to trust this table's shape.
model OrgMembership {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier      String   // Owner | Viewer
  createdAt DateTime @default(now())

  @@index([orgId])
}

// Per-module tier: Admin ("committee chairman", full control of that module)
// or Helper ("committee member", day-to-day entry but not finalize actions).
// A user can hold any number of these — zero, one per module, or several
// modules at once — independent of their org-wide tier (if any).
model ModuleGrant {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String   // bell-jar | rentals | calendar
  tier      String   // Admin | Helper
  grantedBy String?  // audit trail only, not an authorization gate
  createdAt DateTime @default(now())

  @@unique([userId, module])
  @@index([orgId])
}

// Purely cosmetic per-org display-label overrides for the four tier names
// (e.g. an Elks lodge relabeling Owner as "Exalted Ruler"). One label pair
// per org for Admin/Helper — auto-composed with a module's own display name
// in the UI ("Bell Jar " + adminLabel), so no per-module label table is
// needed. Never read by any permission check — behavior always keys off
// OrgMembership.tier / ModuleGrant.tier, not these strings.
model TierLabel {
  id          String   @id @default(cuid())
  orgId       String   @unique
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ownerLabel  String?
  viewerLabel String?
  adminLabel  String?
  helperLabel String?
  updatedAt   DateTime @updatedAt
}

// Dedicated signer for one of the GC-7Q form's 3 legally-specific signature
// slots (Head | Preparer | Member) — separate from module tiers since the
// real form requires specific named officer signatures, independent of who
// does day-to-day Bell Jar data entry. Assignable by the bell-jar module's
// Admin to any user, org-level (persists until reassigned, not per-quarter).
model GC7QSignerDesignation {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot      String   // Head | Preparer | Member — same values as SignOff.role
  createdAt DateTime @default(now())

  @@unique([orgId, slot])
  @@index([orgId])
}

// Same shape and purpose as GC7QSignerDesignation, but for GC-7R (raffle)
// filings — kept as a separate table rather than shared, since an org may
// want different named officers signing the raffle filing than the
// quarterly Bell Jar one. Assignable by the raffle module's Admin.
model RaffleSignerDesignation {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot      String   // Head | Preparer | Member
  createdAt DateTime @default(now())

  @@unique([orgId, slot])
  @@index([orgId])
}

model Deal {
  id            String   @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id])
  name          String
  serialNum     String
  formNum       String
  ticketCount   Int
  ticketPrice   Float
  idealPayout   Float
  labelImage    String?  // base64 data URL of the game's printed label/flare, for verification
  status        String   @default("received") // received (logged, not yet on the floor) | active (on the machine) | closed
  closeThreshold Float   @default(0.75) // fraction of idealPayout that must be awarded before closing; 0.75 is the NYS minimum, orgs may set higher
  soldToDate    Int      @default(0)
  prizesAwardedToDate Float @default(0) // cumulative cash paid to winners (K); other/non-cash prizes (L) not modeled in this build
  createdAt     DateTime @default(now())

  dailySales     DailySale[]
  schedule1      Schedule1Record?

  @@index([orgId])
}

model DailySale {
  id            String   @id @default(cuid())
  dealId        String
  deal          Deal     @relation(fields: [dealId], references: [id])
  date          DateTime @default(now())
  ticketsSold   Int
  cashPaid      Float
  cashCollected Float
  profitLoss    Float
  createdAt     DateTime @default(now())

  @@index([dealId])
}

model Schedule1Record {
  id             String   @id @default(cuid())
  dealId         String   @unique
  deal           Deal     @relation(fields: [dealId], references: [id])
  closedDate     DateTime @default(now())
  cashPrizes     Float
  otherPrizes    Float
  unsoldCount    Int
  unsoldValue    Float
  actualProfit   Float
  retentionUntil DateTime
}

model Disbursement {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  date      DateTime @default(now())
  payee     String
  checkNum  String
  amount    Float
  category  String   // ticket_purchase | license_fee | indirect
  quarter   Int
  year      Int
  receiptFile     String? // base64 data URL of an attached receipt image or PDF
  receiptFileName String? // original filename, for a friendlier download than a generic name
  createdAt DateTime @default(now())

  @@index([orgId])
}

model GC7QReport {
  id                   String   @id @default(cuid())
  orgId                String
  org                  Organization @relation(fields: [orgId], references: [id])
  year                 Int
  quarter              Int
  values               String   // JSON blob of computed A/B/C/D line items
  interestEarned       Float    @default(0) // C11 — not derivable from ledger data, entered manually per quarter
  adjustments          Float    @default(0) // C13 — requires prior NYS Gaming Commission approval
  adjustmentExplanation String?
  status               String   @default("draft") // draft | filed
  createdAt            DateTime @default(now())

  signOffs SignOff[]

  @@unique([orgId, year, quarter])
  @@index([orgId])
}

model SignOff {
  id       String   @id @default(cuid())
  reportId String
  report   GC7QReport @relation(fields: [reportId], references: [id])
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  role     String   // Head | Preparer | Member
  signedAt DateTime @default(now())

  @@unique([reportId, role])
}

// --- Rental Space module ---
// Modeled directly off the lodge's real "Facility Event Space Rental Agreement":
// each space rents in a flat block (blockHours) plus a per-hour overage rate, with
// a separate member/non-member rate, an optional bartender add-on with the same
// block+overage shape, and a handful of itemized equipment fees.
model RentalSpace {
  id                   String   @id @default(cuid())
  orgId                String
  org                  Organization @relation(fields: [orgId], references: [id])
  name                 String   // "Banquet Hall", "Pavilion", "Club Deck"
  capacity             Int?
  blockHours           Int      @default(4)
  baseRateMember       Float    @default(0)
  baseRateNonMember    Float    @default(0)
  overageRateMember    Float    @default(0) // per hour beyond blockHours
  overageRateNonMember Float    @default(0)
  offersBartender      Boolean  @default(false)
  bartenderBaseRate    Float    @default(0) // for blockHours
  bartenderOverageRate Float    @default(0) // per additional hour
  roundTableFee        Float    @default(0) // per 60" round table
  longTableFee         Float    @default(0) // per 8' table
  chairFee             Float    @default(0) // per chair
  kitchenNoOvenFee     Float    @default(0)
  kitchenWithOvenFee   Float    @default(0)
  chafingDishFee       Float    @default(0) // per dish (sterno fee)
  offersLinen          Boolean  @default(false)
  linenRoundTableFee   Float    @default(0) // per 60" round table
  linenLongTableFee    Float    @default(0) // per 8' table
  linenPerGuestFee     Float    @default(0) // per expected guest — combines with the per-table fees, not instead of them
  depositAmount        Float    @default(0) // default reservation deposit, applied toward the total
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())

  bookings          RentalBooking[]
  blocks            RentalBlock[]
  blockRecurrences  RentalBlockRecurrence[]

  @@index([orgId])
}

model RentalBooking {
  id                 String   @id @default(cuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id])
  spaceId            String
  space              RentalSpace @relation(fields: [spaceId], references: [id])
  status             String   @default("inquiry") // inquiry | confirmed | completed | declined | cancelled
  renterName         String
  renterEmail        String
  renterPhone        String?
  renterAddress      String?
  isMember           Boolean  @default(false)
  eventType          String?
  expectedGuests     Int?
  startAt            DateTime
  endAt              DateTime
  wantsBartender     Boolean  @default(false)
  wantsLinen         Boolean  @default(false)
  roundTables        Int      @default(0)
  longTables         Int      @default(0)
  chairs             Int      @default(0)
  kitchenUse         String?  // null | "no_oven" | "with_oven"
  chafingDishes      Int      @default(0)
  quotedTotal        Float?   // computed when confirmed
  depositAmount      Float?   // expected deposit, set at confirmation — actual payments live in RentalPayment
  notes              String?
  declineReason      String?
  contractSignedName  String?  // printed name entered alongside the drawn signature
  contractSignatureImage String? // base64 PNG data URL, drawn in-person on staff's device at signing
  contractSignedIp    String?  // basic audit trail — no third-party e-sign vendor is used here
  contractSignedAt    DateTime?
  uploadedContractFile     String? // base64 data URL — a scan/photo of a physically-signed paper contract, an alternative to the in-app drawn signature above
  uploadedContractFileName String?
  uploadedContractAt       DateTime?
  // Set once the collected funds have actually been turned in/deposited —
  // locks the booking's own details (renter info, dates, space, pricing)
  // against further edits, same "lock after the money's real" pattern as
  // GC7QReport.status "filed". Payments, signing, and lifecycle actions
  // (complete/cancel) are never gated on this — only the PATCH edit route is.
  fundsDepositedAt   DateTime?
  createdAt          DateTime @default(now())

  payments RentalPayment[]
  logs     RentalLog[]

  @@index([orgId])
  @@index([spaceId])
}

// Activity trail for a booking — same purpose and shape as RaffleLog for the
// Raffle module, which Rentals never got. One row per state-changing action
// (edited, confirmed, declined, cancelled, completed, restored, signed,
// contract uploaded, payment added/removed, funds deposited, unlocked),
// recording who (the logged-in staff member, not the renter) and when.
// Never mutated after creation — the trail itself is the point.
model RentalLog {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bookingId String
  booking   RentalBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type      String   // created | edited | confirmed | declined | cancelled | completed | restored | signed | contract_uploaded | payment_added | payment_deleted | funds_deposited | unlocked
  text      String
  actorName String   @default("")
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([bookingId, createdAt])
}

// Replaces the old depositPaid/balancePaid booleans — one row per payment
// received or discount/comp applied, so any amount can be recorded at any
// time instead of only a fixed deposit or "the entire remaining balance" in
// one shot. `amount` is always positive (how much this entry reduces the
// balance due by); `type` distinguishes real money collected ("payment",
// requires a method) from a credit applied for any reason ("adjustment",
// requires a note instead — the "why" on record for a balance that changed
// without cash changing hands).
model RentalPayment {
  id             String   @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        RentalBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount         Float
  type           String   // payment | adjustment
  method         String?  // cash | check — required for "payment", null for "adjustment"
  receiptNum     String?
  note           String?
  recordedByName String
  recordedAt     DateTime @default(now())

  @@index([orgId])
  @@index([bookingId])
}

// Internal hold on a space for the lodge's own use — no renter/contract
// involved. `visibleOnPublicCalendar` defaults true: a members-only meeting or
// function still occupies the space, so anyone browsing the public calendar
// should see it as unavailable, using `reason` as the shown label — the same
// "safe by default" pattern as a confirmed rental (see calendarSync.js).
model RentalBlock {
  id                     String   @id @default(cuid())
  orgId                  String
  org                    Organization @relation(fields: [orgId], references: [id])
  spaceId                String
  space                  RentalSpace @relation(fields: [spaceId], references: [id])
  startAt                DateTime
  endAt                  DateTime
  reason                 String?
  visibleOnPublicCalendar Boolean @default(true)
  recurrenceId           String?
  recurrence             RentalBlockRecurrence? @relation(fields: [recurrenceId], references: [id])
  // Set when this block was spawned by checking "this event uses a rental
  // space" on a one-off Calendar event, rather than created directly from
  // Rental Space > Internal Blocks. The calendar event is the source of
  // truth in that case — deleting it removes the blocks it spawned, and the
  // Internal Blocks list shows these as read-only ("edit from Calendar").
  calendarEventId        String?
  calendarEvent          CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  createdAt              DateTime @default(now())

  @@index([orgId])
  @@index([spaceId])
  @@index([recurrenceId])
  @@index([calendarEventId])
}

// Recurrence rule for a standing internal commitment (e.g. a lodge's
// twice-monthly meeting) — materialized into individual RentalBlock rows the
// same way CalendarRecurrence works, for the same reason: editing or deleting
// a single occurrence stays a plain row operation.
model RentalBlockRecurrence {
  id                     String   @id @default(cuid())
  orgId                  String
  org                    Organization @relation(fields: [orgId], references: [id])
  spaceId                String
  space                  RentalSpace @relation(fields: [spaceId], references: [id])
  reason                 String?
  visibleOnPublicCalendar Boolean @default(true)
  startTime              String   // "HH:mm", applied to each generated occurrence
  endTime                String
  freq                   String   // daily | weekly | monthly
  interval               Int      @default(1)
  byWeekday              String?  // comma list, e.g. "MO,WE" for weekly; single code (e.g. "TU") when byWeekdayOrdinal is set
  byWeekdayOrdinal        String?  // comma list, e.g. "2,4" for "2nd and 4th [byWeekday] of the month"; -1 = last
  startDate              DateTime
  endDate                DateTime
  createdAt              DateTime @default(now())

  blocks RentalBlock[]

  @@index([orgId])
  @@index([spaceId])
}

// --- Calendar module ---
// The shared spine other modules publish onto (Rental bookings/blocks) plus
// manually-created lodge events. Recurring events are materialized up front
// (see server/src/lib/recurrence.js) into individual rows linked by
// recurrenceId, rather than expanded at query time — that keeps "edit just
// this occurrence" a plain single-row update instead of needing exception
// tracking, at the cost of a bounded generation horizon (2 years / 500 rows).
model CalendarEvent {
  id            String   @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id])
  title         String
  description   String?
  location      String?  // freeform — off-site address, or blank/implied "at the lodge"
  linkUrl       String?  // link back to a related website/page (flyer, signup form, event page)
  startAt       DateTime
  endAt         DateTime
  allDay        Boolean  @default(false)
  source        String   @default("manual") // manual | rental-booking | rental-block
  sourceId      String?  // originating record id, for sync/dedupe when the source changes
  visibility    String   @default("internal") // public | internal | private (only visible to createdByUserId, plus calendar Admin/Owner)
  color         String?
  recurrenceId  String?
  recurrence    CalendarRecurrence? @relation(fields: [recurrenceId], references: [id])
  rentalBlocks  RentalBlock[]        // blocks spawned when this one-off event "uses a rental space"
  createdByUserId String?
  createdBy       User?  @relation(fields: [createdByUserId], references: [id])
  createdByName   String @default("") // denormalized — survives the user's own deletion, keeps "created by" accountability display working
  createdAt     DateTime @default(now())

  @@index([orgId])
  @@index([sourceId])
  @@index([recurrenceId])
  @@index([createdByUserId])
}

model CalendarRecurrence {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  title       String
  description String?
  location    String?
  linkUrl     String?
  startTime   String   // "HH:mm", applied to each generated occurrence
  endTime     String
  allDay      Boolean  @default(false)
  visibility  String   @default("internal")
  color       String?
  freq        String   // daily | weekly | monthly
  interval    Int      @default(1)
  byWeekday   String?  // comma list, e.g. "MO,WE" for weekly; single code (e.g. "TU") when byWeekdayOrdinal is set
  byWeekdayOrdinal String? // comma list, e.g. "2,4" for "2nd and 4th [byWeekday] of the month"; -1 = last
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())

  events CalendarEvent[]

  @@index([orgId])
}

// --- Raffle module ---
// Ported from a standalone FastAPI+MongoDB app ("400 Club" — the name of the
// underlying raffle game itself, not this module) that sells N numbered
// raffle tickets per year.
//
// A lodge can run more than one raffle at once (e.g. an annual "400 Club"
// alongside a smaller concurrent "50/50"), so each raffle is its own
// RaffleGame row rather than one implicit "current" raffle per org. Every
// ticket/log/drawing/check-in/renewal-call belongs to exactly one game via
// gameId. Closing a game is just a status flip — its rows are never copied
// to a separate archive table or deleted, so full historical detail (who
// bought which ticket, in which past game) stays queryable forever. That's
// also what powers "previously purchased by" lookups when a ticket number
// comes up again in a later game (see GET .../tickets/:number/history in
// raffle.js) — a plain query across the org's other games' RaffleTicket
// rows, no separate buyer-history table needed.

model RaffleGame {
  id              String    @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String    // "2026 400 Club", "Spring 50/50" — shown in the game switcher
  startNumber     Int
  endNumber       Int
  totalTickets    Int       // endNumber - startNumber + 1, stored for display convenience
  ticketPrice     Float
  raffleStartDate DateTime
  raffleEndDate   DateTime  // closing date / final drawing
  status          String    @default("active") // active | closed
  closedAt        DateTime?
  estimatedExpenses Float   @default(0) // rough non-prize-expense planning number the chairman can set anytime, for an early compliance projection before real RaffleExpense rows exist — not part of the official GC-7R math once actuals are entered
  isHistorical    Boolean   @default(false) // true for a past-years CSV import kept only to power the "past buyers" lookup — hidden from the live game switcher and every operational raffle screen
  admitsPerTicket Int       @default(1) // how many guests one ticket admits to the drawing event — printed/emailed as "good for N guests" (this raffle's physical ticket says "entitles 2 persons to attend")
  minimumTicketsSold Int?   // compliance/business threshold below which the raffle may need to refund or extend sales, per the physical ticket's "per minimum sale of 300 tickets or refund" — reference/display only, no automatic enforcement
  eventVenue         String? // where the drawing event itself is held, e.g. "Elks Lodge, 7711 Albany Post Road, Red Hook, NY 12571"
  eventDoorsOpenTime String? // free-text time label for the drawing event, e.g. "1:00 PM" — a printed label, not a computed DateTime
  eventDetails       String? // freeform notes for the rest of the event-day info (food, drinks, cash bar hours, drawing time, etc.)
  previousGameId  String?   // admin-chosen link to an earlier RaffleGame (operational or historical) to pull "past buyers" from — explicit, not name-matching, so it works regardless of how raffles are named. SetNull on delete so removing an old raffle/import just breaks the chain link rather than blocking the delete or cascading.
  previousGame    RaffleGame?  @relation("RaffleGameChain", fields: [previousGameId], references: [id], onDelete: SetNull)
  nextRaffleGames RaffleGame[] @relation("RaffleGameChain")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tickets      RaffleTicket[]
  logs         RaffleLog[]
  drawings     RaffleDrawing[]
  renewalCalls RaffleRenewalCall[]
  checkIns     RaffleCheckIn[]
  expenses     RaffleExpense[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([previousGameId])
}

// Opted out of raffle marketing email (the season-kickoff blast) for this
// org specifically — not platform-wide, since a buyer opting out of one
// lodge's raffle emails has no bearing on another org's. Sale
// confirmations/e-tickets/payment reminders are transactional, not
// marketing, so they're unaffected by this list.
model RaffleEmailSuppression {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email     String   // normalized: trimmed + lowercased
  createdAt DateTime @default(now())

  @@unique([orgId, email])
  @@index([orgId])
}

model RaffleTicket {
  id                 String   @id @default(cuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  gameId             String
  game               RaffleGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  number             Int
  status             String   @default("available") // available | reserved | sold | funds_received
  buyer              String   @default("")
  phone              String   @default("")
  email              String   @default("")
  address            String   @default("")
  assignedSellerId   String?
  assignedSeller     User?    @relation("RaffleAssignedSeller", fields: [assignedSellerId], references: [id])
  assignedSellerName String   @default("") // denormalized — survives seller deletion, preserves audit trail
  soldByUserId       String?
  soldByName         String   @default("")
  soldAt             DateTime?
  tenderType         String?  // cash | check
  tenderAmount       Float?
  checkNumber        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([gameId, number]) // per-game, not per-org — two concurrent games can each have their own #1
  @@index([orgId, number])   // powers the cross-game "previous buyers of this ticket number" lookup
  @@index([gameId])
}

model RaffleLog {
  id               String   @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  gameId           String
  game             RaffleGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  type             String   // sold | reserved | funds_received | released | reassigned | drawing | checkin | reminder_sent | email_sent | game_started | game_closed | game_reopened
  text             String
  sellerName       String   @default("")
  ticketNumber     Int?
  assignedSellerId String?
  createdAt        DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([gameId, createdAt])
}

model RaffleDrawing {
  id            String   @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  gameId        String
  game          RaffleGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name          String
  drawingDate   DateTime
  drawingType   String   // early_bird | main
  prizeAmount   Float
  notes         String   @default("")
  winningTicket Int?
  winningBuyer  String   @default("")
  winningPhone  String   @default("")
  eligibleCount Int      @default(0)
  drawnAt       DateTime?
  drawnByName   String   @default("")
  drawMode      String?  // random | manual
  createdAt     DateTime @default(now())

  @@index([orgId])
  @@index([gameId])
}

// A raffle's real, itemized non-prize operating expenses — the raffle analog
// of Disbursement, but scoped to one RaffleGame (one raffle occasion) instead
// of org+quarter/year, matching how GC-7R itself reports per-occasion. Not
// locked to active games: real bills legitimately arrive after the drawing
// and before the 30-day GC-7R filing deadline.
model RaffleExpense {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  gameId    String
  game      RaffleGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  payee     String
  checkNum  String
  amount    Float
  category  String   // tickets | license_fee | equipment_supplies | services | rent | other
  receiptFile     String? // base64 data URL of an attached receipt image or PDF
  receiptFileName String? // original filename, for a friendlier download than a generic name
  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([gameId])
}

model RaffleRenewalCall {
  id             String   @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  gameId         String
  game           RaffleGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  ticketNumber   Int
  calledByUserId String?
  calledByName   String   @default("")
  note           String   @default("")
  calledAt       DateTime @default(now())

  @@unique([gameId, ticketNumber])
}

// New — doesn't exist in the source app (built fresh per product decision).
// Scoped per game, not per-drawing: someone checks in once for raffle night
// regardless of how many drawings happen that evening.
model RaffleCheckIn {
  id                String   @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  gameId            String
  game              RaffleGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  ticketNumber      Int
  hasGuest          Boolean  @default(false)
  checkedInByUserId String?
  checkedInByName   String   @default("")
  checkedInAt       DateTime @default(now())

  @@unique([gameId, ticketNumber])
  @@index([gameId])
}

// --- Elks Tools module ---
// One saved run per lodge per month — regenerating a month's report
// (correcting a mistake, re-uploading) replaces the prior save for that
// month rather than piling up duplicates, since only one file per month is
// ever actually the real submission.
model FrsReportRun {
  id               String   @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  year             Int
  month            Int      // 1-12
  monthLabel       String   // "May 2026" — display convenience
  sourceFile       String   // base64 data URL of the uploaded QuickBooks .xlsx
  sourceFileName   String
  csvFile          String   // the generated CSV content
  csvFileName      String
  transactionCount Int
  totalDebits      Float
  totalCredits     Float
  generatedByName  String
  generatedAt      DateTime @default(now())

  @@unique([orgId, year, month])
  @@index([orgId])
}
