# Local dev (SQLite, no setup needed):
# DATABASE_URL="file:./dev.db"

# Production (Railway sets this automatically when you add the Postgres plugin):
# DATABASE_URL="postgresql://user:password@host:port/dbname"

JWT_SECRET="replace-with-a-long-random-value"
PORT=4000

# The client's own public URL — used to build links in outbound emails (e.g.
# the password-reset link). Local dev: http://localhost:5173. Production:
# the deployed app's real URL (e.g. https://app.elkslodges.org).
APP_URL="http://localhost:5173"
